extends layout

block content
  a(href="/") Return to the homepage
  h1 Add a Property Listing
  p.lead Complete all three properties to create a record in HubSpot.
  if errors.length
    .error(role="alert")
      p Please check the following:
      ul
        each error in errors
          li= error
  form(method="POST" action="/update-cobj")
    input(type="hidden" name="_csrf" value=csrfToken)
    label(for="name") Name
    input#name(type="text" name="name" required maxlength="150" value=values.name)
    label(for="area") Area
    input#area(type="text" name="area" required maxlength="150" value=values.area)
    label(for="price") Asking price (MYR)
    input#price(type="number" name="price" min="0.01" max="999999999999.99" step="0.01" required value=values.price)
    button(type="submit") Create record
